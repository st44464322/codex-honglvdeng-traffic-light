<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ss.codex-traffic-light</string>

  <key>ProgramArguments</key>
  <array>
    <string>__SUPPORT_DIR__/CodexTrafficLight</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__SUPPORT_DIR__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <false/>

  <key>LimitLoadToSessionType</key>
  <array>
    <string>Aqua</string>
  </array>

  <key>StandardOutPath</key>
  <string>__SUPPORT_DIR__/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>__SUPPORT_DIR__/launchd.err.log</string>
</dict>
</plist>
